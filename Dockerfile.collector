# Tick collector only. Public endpoint, no credentials, no env secrets.
# The base image tag is NOT pinned by digest here. On the VM, pin it (docs/runbook.md, "Pin the base image").
FROM python:3.12-slim

ARG APP_UID=1000
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    COLLECTOR_CONFIG=/app/config/collector.json

RUN useradd --system --uid ${APP_UID} --no-create-home --shell /usr/sbin/nologin collector \
 && mkdir /data && chown ${APP_UID} /data

WORKDIR /app
COPY requirements-collector.txt ./
RUN pip install --no-cache-dir -r requirements-collector.txt

COPY src ./src
COPY config ./config

USER collector
VOLUME /data
CMD ["python", "-m", "derivbot.collector"]
