# Tick collector only. Public endpoint, no credentials, no env secrets.
# Pinned by digest on 2026-10-31 (UTC). The digest is the multi-arch index (amd64, arm64, ...), so it builds on either
# Oracle shape. To update: docker pull python:3.12-slim, read RepoDigests, review, edit, rebuild, run the tests.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ARG APP_UID=1000
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    COLLECTOR_CONFIG=/app/config/collector.json

RUN useradd --system --uid ${APP_UID} --no-create-home --shell /usr/sbin/nologin collector \
 && mkdir /data && chown ${APP_UID} /data

WORKDIR /app
COPY requirements-collector.txt ./
RUN pip install --no-cache-dir -r requirements-collector.txt

COPY src ./src
COPY config ./config

USER collector
VOLUME /data
CMD ["python", "-m", "derivbot.collector"]
